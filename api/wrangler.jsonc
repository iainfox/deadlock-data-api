{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deadlock-data-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "deadlock-data"
    }
  ]
}
